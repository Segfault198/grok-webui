[Unit]
Description=Maintain leaf wiki belief files across shared/projects
After=network-online.target

[Service]
Type=oneshot
User=steve
Group=steve
WorkingDirectory=/home/steve
Environment=HOME=/home/steve
ExecStart=/usr/bin/python3 /home/steve/.local/share/hzr-skills/leaf-wiki/scripts/maintain-beliefs.py --scan-oc-shared --home /home/steve
Nice=10
