[Unit]
Description=Maintain + calibrate leaf wiki belief files across shared/projects
After=network-online.target

[Service]
Type=oneshot
User=steve
Group=steve
WorkingDirectory=/home/steve
Environment=HOME=/home/steve
Environment=BELIEFS_INSTALL_ROOT=/home/steve/.local/share/hzr-skills/leaf-wiki
ExecStart=/home/steve/.local/share/hzr-skills/leaf-wiki/scripts/beliefs-daily.sh
Nice=10
